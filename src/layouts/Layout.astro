---
import "../styles/global.css";
import ProfileCard from "../components/ProfileCard.astro";
import Navigation from "../components/Navigation.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Jacky Chen - Fullstack Developer ",
  description = "A showcase of my projects and skills.",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&family=Geist+Mono:wght@100..900&display=swap"
      rel="stylesheet"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body
    class="min-h-screen lg:h-screen lg:overflow-hidden relative text-foreground bg-background font-sans antialiased"
  >
    <!-- Background Effects -->
    <div
      aria-hidden="true"
      class="pointer-events-none fixed inset-0 -z-10 overflow-hidden"
    >
      <!-- Ambient glowing orbs -->
      <div
        class="absolute top-[-10%] left-[-8%] w-160 h-160 rounded-full bg-foreground/[0.03] dark:bg-white/[0.03] blur-[130px]"
      >
      </div>
      <div
        class="absolute bottom-[-15%] right-[-12%] w-170 h-170 rounded-full bg-foreground/[0.02] dark:bg-white/[0.02] blur-[140px]"
      >
      </div>
      <div
        class="absolute top-[35%] right-[25%] w-115 h-115 rounded-full bg-foreground/[0.02] dark:bg-white/[0.02] blur-[120px]"
      >
      </div>

      <!-- Dot grid overlay -->
      <div
        class="absolute inset-0 bg-dot-grid opacity-25 dark:opacity-30 mix-blend-overlay"
      >
      </div>
    </div>

    <div
      class="px-3 py-4 sm:px-5 sm:py-6 md:px-6 lg:px-8 lg:py-6 xl:px-12 xl:py-8 2xl:px-20 lg:h-full"
    >
      <div
        class="grid grid-cols-12 gap-4 lg:gap-5 xl:gap-6 items-start lg:items-stretch lg:h-full"
      >
        <!-- Left Sidebar / Profile Card -->
        <div
          class="relative col-span-12 p-3 sm:p-4 text-sm sm:text-base text-center rounded-2xl bg-glass-panel backdrop-blur-2xl backdrop-saturate-150 border border-glass-border shadow-xl shadow-black/5 dark:shadow-2xl dark:shadow-black/60 lg:col-span-4 xl:col-span-3 lg:h-full lg:min-h-0 lg:overflow-y-auto scroll-area before:absolute before:inset-x-0 before:top-0 before:h-px before:rounded-t-2xl before:bg-linear-to-r before:from-transparent before:via-foreground/15 dark:before:via-white/20 before:to-transparent"
        >
          <ProfileCard />
        </div>

        <!-- Right Main Content -->
        <div
          class="relative flex flex-col col-span-12 rounded-2xl bg-glass-panel backdrop-blur-2xl backdrop-saturate-150 border border-glass-border shadow-xl shadow-black/5 dark:shadow-2xl dark:shadow-black/60 lg:col-span-8 xl:col-span-9 lg:h-full lg:min-h-0 lg:overflow-hidden scroll-area before:absolute before:inset-x-0 before:top-0 before:h-px before:rounded-t-2xl before:bg-linear-to-r before:from-transparent before:via-foreground/15 dark:before:via-white/20 before:to-transparent"
        >
          <Navigation />

          <div class="flex-1 overflow-y-auto scroll-area pb-12 sm:pb-8">
            <slot />
          </div>
        </div>
      </div>
    </div>

    <script>
      function initScrollAnimation() {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add("animate-in");
                entry.target.classList.remove("opacity-0");
                observer.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: "0px 0px -50px 0px" },
        );

        document.querySelectorAll(".scroll-animate").forEach((el) => {
          observer.observe(el);
        });
      }

      document.addEventListener("astro:page-load", initScrollAnimation);
    </script>
  </body>
</html>
