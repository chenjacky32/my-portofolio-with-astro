---
interface Props {
  title: string;
  subTitle: string;
  period?: string;
  location?: string;
  description?: string;
  bulletPoints?: string[];
  class?: string;
  style?: string | Record<string, any>;
}

const {
  title,
  subTitle,
  period,
  location,
  description,
  bulletPoints,
  class: className = "",
  style,
  ...rest
} = Astro.props;
---

<div
  class:list={[
    "relative pl-4 border-l border-primary/20 dark:border-primary/20",
    className,
  ]}
  style={style}
  {...rest}
>
  <div class="absolute w-3 h-3 bg-primary rounded-full left-[-6.5px] top-1">
  </div>
  <h5 class="mb-1 text-base sm:text-lg xl:text-xl font-bold">
    {title}
  </h5>
  <p class="font-semibold text-xs sm:text-sm text-primary">
    {subTitle}
  </p>
  {
    period && (
      <p class="text-xs sm:text-sm font-mono text-muted-foreground">{period}</p>
    )
  }
  {
    location && (
      <p class="text-xs sm:text-sm text-muted-foreground">{location}</p>
    )
  }

  {
    description && (
      <p class="my-2 space-y-1 text-sm text-muted-foreground text-justify">
        {description}
      </p>
    )
  }

  {
    bulletPoints && bulletPoints.length > 0 && (
      <ul class="my-2 ml-4 list-disc text-sm space-y-1 text-muted-foreground text-justify">
        {bulletPoints.map((point) => (
          <li>{point}</li>
        ))}
      </ul>
    )
  }

  <slot />
</div>
