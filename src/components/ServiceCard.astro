---
import type { MyServiceCard } from "../lib/utils";
import Icon from "./Icon.astro";

interface Props extends MyServiceCard {
  class?: string;
  style?: string | Record<string, any>;
}

const { icon, title, description, class: className, style, ...rest } = Astro.props;
---

<div
  class:list={[
    "group relative flex items-center p-3 sm:p-4 gap-3 sm:gap-4 rounded-xl bg-glass-card backdrop-blur-md backdrop-saturate-150 border border-glass-border hover:border-primary/50 hover:bg-secondary/40 hover:shadow-bloom-sm transition-all duration-300",
    className
  ]}
  style={style}
  {...rest}
>
  <div
    class="shrink-0 flex items-center justify-center w-11 h-11
    sm:w-12 sm:h-12 xl:w-14 xl:h-14 rounded-xl bg-gradient-glass-icon
    border border-glass-border transition-transform duration-300 group-hover:scale-105"
  >
    <Icon
      name={icon}
      class="w-5 h-5 sm:w-6 sm:h-6 xl:w-7 xl:h-7 text-primary"
    />
  </div>
  <div class="flex-1 min-w-0">
    <h6 class="text-sm sm:text-base font-semibold text-foreground">
      {title}
    </h6>
    <p
      class="text-xs sm:text-sm text-muted-foreground leading-relaxed"
      set:html={description}
    />
  </div>
</div>
