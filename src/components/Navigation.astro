---
import { links } from "../lib/utils";
const pathname = Astro.url.pathname;
---

<nav
  aria-label="Primary"
  class="sticky top-0 z-20 flex flex-col sm:flex-row sm:items-center justify-between px-4 sm:px-5 py-3 sm:py-4 transition-[background-color,border-color,backdrop-filter] duration-200 bg-glass-panel backdrop-blur-2xl backdrop-saturate-150 border-b border-glass-border shadow-sm rounded-t-2xl sm:rounded-none"
>
  <span
    class="relative inline-block text-lg sm:text-xl xl:text-2xl font-semibold tracking-tight pb-1 mb-2 sm:mb-0"
  >
    {
      links.find(
        (link) => link.href === pathname || pathname === link.href + "/",
      )?.label || "Portfolio"
    }
    <span
      class="absolute bottom-0 left-0 right-0 h-0.5 w-8 rounded-full bg-gradient-primary"
    ></span>
  </span>

  <div
    class="flex overflow-x-auto scroll-area pb-1 sm:pb-0 text-sm sm:text-base xl:text-lg font-normal gap-1 sm:gap-2"
  >
    {
      links.map((link) => {
        const isActive = pathname === link.href || pathname === link.href + "/";
        return (
          <a
            href={link.href}
            class="relative inline-block px-3 py-1 rounded-md cursor-pointer transition-colors duration-200
              focus:outline-none focus-visible:ring-2 focus-visible:ring-ring whitespace-nowrap"
          >
            {isActive && (
              <span
                transition:name="active-nav-indicator"
                class="absolute inset-1 rounded-md bg-primary/10 ring-1 ring-primary/30"
              />
            )}
            <span
              class={`relative z-10 transition-colors duration-200 ${isActive ? "text-primary font-medium" : "text-muted-foreground hover:text-foreground"}`}
            >
              {link.label}
            </span>
          </a>
        );
      })
    }
  </div>
</nav>
