---
interface Props {
  href: string;
  "aria-label": string;
}

const { href, "aria-label": ariaLabel } = Astro.props;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  aria-label={ariaLabel}
  class="hover:text-primary hover:scale-110 transition-all duration-200"
>
  <slot />
</a>
