---
interface Props {
  title: string;
  items: string[];
  class?: string;
}

const { title, items, class: className } = Astro.props;
---

<div class={className}>
  <h5 class="mb-4 text-lg sm:text-xl xl:text-2xl font-bold">
    {title}
  </h5>
  <div class="flex flex-wrap gap-2">
    {
      items.map((item) => (
        <span class="inline-flex items-center px-3 py-1 text-xs sm:text-sm font-mono rounded-full bg-glass-input backdrop-blur-sm border border-glass-border text-muted-foreground hover:border-primary/60 hover:text-primary transition-colors duration-200">
          {item}
        </span>
      ))
    }
  </div>
</div>
