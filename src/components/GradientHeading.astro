---
import type { HTMLTag, Polymorphic } from "astro/types";

type Props<Tag extends HTMLTag> = Polymorphic<{ as: Tag }>;

const { as: Tag = "h2", class: className, ...props } = Astro.props;
---

<Tag
  class:list={[
    "font-semibold tracking-tight bg-gradient-primary bg-clip-text text-transparent inline-block",
    className,
  ]}
  {...props}
>
  <slot />
</Tag>
